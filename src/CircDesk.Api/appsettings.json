{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "UseSqlite": false,
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=CircDesk;User Id=sa;Password=Your_password123!;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Issuer": "CircDesk",
    "Audience": "CircDesk.Clients",
    "Key": "CHANGE_THIS_DEV_ONLY_SIGNING_KEY_32+CHARS",
    "ExpiresMinutes": 60
  },
  "Circulation": {
    "LoanPeriodDays": 14,
    "RenewalExtensionDays": 7,
    "MaxRenewalsPerLoan": 1,
    "MaxActiveLoansPerMember": 5,
    "HoldExpirationHours": 48,
    "FinePerDayLate": 1.00,
    "MaxFinePerLoan": 20.00,
    "OutstandingFineBlockThreshold": 50.00
  }
}
